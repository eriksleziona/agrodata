# AgroData local development configuration
# Copy this file to .env and supply local-only values. Never commit .env.

# Application
AGRODATA_ENV=development
AGRODATA_LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# PostgreSQL / PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrodata
POSTGRES_USER=agrodata
POSTGRES_PASSWORD=

# Redis and MQTT
REDIS_URL=redis://localhost:6379/0
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=agrodata
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Security
APP_SECRET_KEY=
